# Build Parameters
OPENCHAMBER_VERSION=1.12.3
OPENCODE_VERSION=1.16.2
TTYD_VERSION=1.7.7

# Runtime Parameters
# Host port for the OpenChamber web UI. Maps 1:1 to container port 6000
# (declared by `EXPOSE 6000` in the Dockerfile; the openchamber web
# server is started with `--port 6000` in `docker-entrypoint.sh`).
OPENCHAMBER_PORT=6000
# Host port for the ttyd browser terminal. Should be one above
# OPENCHAMBER_PORT. Maps 1:1 to container port 6001 (declared by
# `EXPOSE 6001` in the Dockerfile; ttyd is started with `-p 6001`
# in `docker-entrypoint.sh`).
TTYD_PORT=6001
OPENCHAMBER_UI_PASSWORD=

# Optional runtime provider credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GITHUB_TOKEN=
